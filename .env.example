# ==============================================================================
# 🌿 Merlot AutoProcure AI - Enterprise Production Configuration (.env)
# ==============================================================================

# 1. SERVER & NETWORK CONFIGURATION
PORT=5001
NODE_ENV=production

# Security & API Authentication Key for Agent Admin & Financial Operations
AGENT_API_KEY=merlot_secure_agent_key_2026

# 2. META WHATSAPP BUSINESS CLOUD API (Official & 1,000 Free Conversations / Month)
# Get from: https://developers.facebook.com -> My Apps -> WhatsApp -> API Setup
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_VERIFY_TOKEN=merlot_procure_agent_2026
META_WA_API_VERSION=v20.0

# (Optional Alternative: Twilio WhatsApp)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=

# 3. AI / LLM REASONING ENGINE (Google Gemini 1.5 Flash has a 100% FREE Tier)
# Get FREE from: https://aistudio.google.com/app/apikey (15 requests/min free)
GEMINI_API_KEY=

# (Optional Alternative: OpenAI GPT-4o)
# OPENAI_API_KEY=

# 4. AUTONOMOUS 24/7 BACKGROUND WATCHDOG DAEMON
# When true, scans inventory every X minutes and triggers restock WhatsApp automatically
AUTO_RESTOCK_DAEMON=true
RESTOCK_SCAN_INTERVAL_MINUTES=10

# 5. RETAIL POS / ERP DATABASE SYNC
# Default SQLite database path (or point to MySQL/Postgres in production)
POS_DB_PATH=C:/Users/asus/Downloads/retail-pos-app/backend/localdb.sqlite

# 6. BANKING & AUTOMATED VENDOR PAYOUT GATEWAY (Optional)
# If using RazorpayX or Cashfree for automated instant UPI/NEFT payouts:
# RAZORPAYX_KEY_ID=
# RAZORPAYX_KEY_SECRET=
# RAZORPAYX_ACCOUNT_NUMBER=
